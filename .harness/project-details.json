{
  "project": {
    "name": "@ai-harness/cli",
    "description": "AI Harness Framework — bootstrap and sync context for AI tools in any project",
    "type": "single",
    "stack": {
      "backend": ["typescript", "nodejs"],
      "frontend": [],
      "infra": ["github-actions", "npm"]
    }
  },
  "structure": {
    "root": ".",
    "apps": ["."],
    "packages": [],
    "shared": []
  },
  "commands": {
    "lint": "",
    "test": "",
    "typecheck": "npm run typecheck",
    "build": "npm run build",
    "dev": "",
    "custom": {
      "clean": "npm run clean",
      "dev:init": "npm run dev:init",
      "dev:sync": "npm run dev:sync"
    }
  },
  "conventions": {
    "branch_pattern": "feat|fix|chore/{description}",
    "commit_pattern": "conventional-commits",
    "pr_template": ".github/pull_request_template.md"
  },
  "context_hints": {
    "entry_points": [
      "src/cli.ts",
      "src/index.ts"
    ],
    "avoid_paths": [
      "dist/",
      "node_modules/",
      "coverage/",
      "scaffold/"
    ],
    "critical_files": [
      "src/commands/init.ts",
      "src/detector/index.ts",
      "src/sync.ts",
      "src/adapters/claude-code.ts",
      "src/adapters/cursor.ts"
    ]
  }
}
