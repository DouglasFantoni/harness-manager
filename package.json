{
  "name": "@ai-harness/cli",
  "version": "1.0.0",
  "description": "AI Harness Framework — bootstrap and sync context for AI tools in any project",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "harness": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "scaffold/",
    "scripts/"
  ],
  "scripts": {
    "build": "tsc && node scripts/postbuild.js",
    "dev:init": "tsx src/cli.ts init",
    "dev:sync": "tsx src/cli.ts sync",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.17",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "harness",
    "cursor",
    "claude",
    "copilot",
    "context",
    "scaffold"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sync": {
      "import": "./dist/sync.js",
      "types": "./dist/sync.d.ts"
    }
  },
  "vitest": {
    "environment": "node",
    "include": [
      "src/**/*.test.ts",
      "tests/**/*.test.ts"
    ],
    "coverage": {
      "provider": "v8",
      "reporter": [
        "text",
        "lcov"
      ],
      "include": [
        "src/**/*.ts"
      ],
      "exclude": [
        "src/cli.ts",
        "src/**/*.test.ts"
      ]
    }
  }
}
