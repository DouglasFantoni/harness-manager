{
  "name": "@ai-harness/cli",
  "version": "1.0.0",
  "description": "AI Harness Framework — bootstrap and sync context for AI tools in any project",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "harness": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "scaffold/",
    "scripts/"
  ],
  "scripts": {
    "build": "tsc && node scripts/postbuild.js",
    "dev:init": "tsx src/cli.ts init",
    "dev:sync": "tsx src/cli.ts sync",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "harness:sync": "harness sync",
    "harness:init": "harness sync --init"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@ai-harness/sync": "latest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "harness",
    "cursor",
    "claude",
    "copilot",
    "context",
    "scaffold"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sync": {
      "import": "./dist/sync.js",
      "types": "./dist/sync.d.ts"
    }
  }
}
